class Solution {
public:
    bool isArraySpecial(vector<int>& nums) {
        int count = 0;
        if(nums.size()==1){
            return true;
        }
        for(int i = 0;i<nums.size()-1;i++){
            if(nums[i]%2==0 && nums[i+1]%2!=0){
                count++;
            }
            else if(nums[i]%2!=0 && nums[i+1]%2==0){
                count++;
            }
            else{
                break;
            }
        }
        if(count<nums.size()-1){
            return false;
        }
        return true;
    }
};
