so have to find missing number here what we can do is
we can use nested loops to loops over every element if it is not in the array we return that element.
brute approach ---
class Solution {
public:
    int missingNumber(vector<int>& nums) {
        int j = 0;
        int i = 0;
        for( i = 0;i<=nums.size();i++){
            int flag = 0;
            for( j =0;j<nums.size();j++){
                if(nums[j]==i){
                    flag = 1;
                    break;
                }
            }
            if(flag==0){
                break;
            }
        }
        return i;
         
    }
};
time complexity - O(n*n);

optimal approach ----
In this we take the sum of first n natural numbers and the sum of the array elements and then return sum1-sum2
code ---
class Solution {
public:
    int missingNumber(vector<int>& nums) {
        int sum1 = nums.size()*(nums.size()+1)/2;
        int sum2 = 0;
        for(int i =0;i<nums.size();i++){
            sum2 += nums[i];
        }
        return sum1-sum2;
    }
};
time complexity- O(n)

another optimal approach by using XOR---
xor gives 0 for same no and xor of 0 with any no other than 0 is that number.
code---
class Solution {
public:
    int missingNumber(vector<int>& nums) {
        int xor1 = 0;
        int xor2 = 0;
        for(int i =1;i<=nums.size();i++){
            xor1 = xor1^i;
        }
        for(int i =0;i<nums.size();i++){
            xor2 = xor2^nums[i];
        }
        return xor1^xor2;
    }
};

