class Solution {
public:
    int missingNumber(vector<int>& nums) {
        int found = 0;
        for(int i = 0;i<=nums.size();i++){
            auto it = find(nums.begin(), nums.end(), i);
            if(it == nums.end()){
                found = i;
                break;
            }
        }
        return found;
        
    }
};
