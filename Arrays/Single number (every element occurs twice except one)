So in this question every element appears twice except one.We have to find the element that appears once.
This is the perfect opportuinty for us to use Xor, xor of two similar no gives 0 and that of 0 with any other no is that no.
code---
class Solution {
public:
    int singleNumber(vector<int>& nums) {
        int xor1 = 0;
        for(int i =0;i<nums.size();i++){
            xor1 ^=nums[i];
        }
        return xor1;
    }
};
time complexity ---O(n);
