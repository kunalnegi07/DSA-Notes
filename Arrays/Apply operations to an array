class Solution {
public:
    vector<int> applyOperations(vector<int>& nums) {
        int j = 0;
        bool flag = true;
        for(int i =0;i<nums.size()-1;i++){
            if(nums[i]==0 && flag == true){
                j = i;
                flag = false;
            }
            if(nums[i]==nums[i+1]){
                nums[i] *= 2;
                nums[i+1] = 0;
            }
        }
        for(int i =j+1;i<nums.size();i++){
            if(nums[i]!=0 && flag==false){
                swap(nums[j],nums[i]);
                j++;
            }
        }
        return nums;
        

    }
};
Time complexity--- O(n)
