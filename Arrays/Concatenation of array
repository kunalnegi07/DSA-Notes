class Solution {
public:
    vector<int> getConcatenation(vector<int>& nums) {
        vector <int> v;
        for(int i = 0; i<2*nums.size();i++){
            if(i>nums.size()-1){
                for(int j = 0; j<nums.size();j++){
                    v.push_back(nums[j]);
                }
                break;
            }
            else{
                v.push_back(nums[i]);
           }
           
        }
        return v;
    }
};
