class Solution {
public:
    int majorityElement(vector<int>& nums) {
        unordered_map<int,int> mpp;
        int result = 0;
        for(int i = 0; i<nums.size();i++){
            mpp[nums[i]]++;
        }
        for(int j = 0; j<nums.size();j++){
            if(mpp[nums[j]]>nums.size()/2){
                result = nums[j];
                break;
            }
        }
        return result;
        
    }
};
