class Solution {
public:
    int buyChoco(vector<int>& prices, int money) {
        sort(prices.begin(),prices.end(),greater<int>());
        int first = prices[prices.size()-1];
        prices.pop_back();
        int second = prices[prices.size()-1];
        if(first+second<=money){
            return money-(first+second);
        }
        return money;
    }
};
