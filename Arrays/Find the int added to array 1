class Solution {
public:
    int addedInteger(vector<int>& nums1, vector<int>& nums2) {
        long long sum1 = 0;
        long long sum2 = 0;
        for(int i = 0;i<nums1.size();i++){
            sum1 += nums1[i];
        }
        for(int i = 0;i<nums2.size();i++){
            sum2 += nums2[i];
        }
        long long result = (sum2-sum1)/(long long)nums1.size();
        return result;
    }
};
