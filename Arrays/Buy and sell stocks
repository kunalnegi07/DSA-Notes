If you are selling on ith day you have to buy on the minimum price from 1st -> i-1 day
code---
int mini = prices[0];
int maxProfit = 0;
int n = prices.size();
for(int i=0;i<n;i++){
    int cost = prices[i] - mini;
    maxProfit = max(maxProfit,cost);
    mini = min(mini,prices[i]);
}
return maxProfit;
