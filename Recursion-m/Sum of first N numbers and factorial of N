Paramatised way---
void printSum(int n ,int sum){
  if(n<1){
      cout<<sum;
      return;
  }
  printSum(n-1,sum+n);
}

int main() {
    int n;
    cout<<"Enter the integer till which you want to know the sum of : ";
    cin>>n;
	printSum(n,0);

}

Functional way---
int printSum(int n){
  if(n==0){
      return 0;
  }
  return n+printSum(n-1);
}

int main() {
    int n;
    cout<<"Enter the integer till which you want to know the sum of : ";
    cin>>n;
	int result = printSum(n);
    cout<<result;
}

Factorial of first N numbers ---
int printfact(int n){
  if(n==0){
      return 1;
  }
  return n*printfact(n-1);
}

int main() {
    int n;
    cout<<"Enter the integer you want factorial of : ";
    cin>>n;
	int result = printfact(n);
    cout<<result;
}




















